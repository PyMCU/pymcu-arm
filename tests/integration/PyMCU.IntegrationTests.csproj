<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>PyMCU.IntegrationTests</RootNamespace>
        <AssemblyName>PyMCU.IntegrationTests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- RP2040Sharp.TestKit is published on nuget.org -->
        <PackageReference Include="RP2040Sharp.TestKit" Version="1.0.0" />
        <!-- RP2350.TestKit is not on nuget.org yet: reference the sibling repo locally.
             Assumes RP2350Sharp is checked out beside pymcu-arm under the same parent. -->
        <ProjectReference Include="../../../RP2350Sharp/src/RP2350.TestKit/RP2350.TestKit.csproj" />
        <!-- The CYW43439 WiFi chip model, to validate the PyMCU WiFi HAL's gSPI bring-up. -->
        <ProjectReference Include="../../../RP2350Sharp/src/RP2350.Wireless/RP2350.Wireless.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="FluentAssertions" Version="6.12.0" />
    </ItemGroup>

</Project>
